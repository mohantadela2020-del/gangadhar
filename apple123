// =========================================================================
// STEP 1 & 2: REPLICATED FXML CONTROLLER ARCHITECTURE (USING PURE JAVA FOR PORTAL)
// =========================================================================
class TipCalculatorController {
    // Simulated @FXML Injection nodes for platform validation
    public String billAmountText = "";
    public String tipPercentageText = "";
    public String tipAmountLabelText = "Tip Amount: $0.00";
    public String errorMessageLabelText = "";

    // Step-2: Implement calculateTip() method
    public void calculateTip(String billInput, String tipInput) {
        try {
            this.billAmountText = billInput;
            this.tipPercentageText = tipInput;
            
            // Input Validation: Check for blank inputs
            if (billInput.trim().isEmpty() || tipInput.trim().isEmpty()) {
                throw new NumberFormatException("Empty fields");
            }

            // Parse values (Triggers NumberFormatException for non-numeric values)
            double billAmount = Double.parseDouble(billInput);
            double tipPercentage = Double.parseDouble(tipInput);

            if (billAmount < 0 || tipPercentage < 0) {
                throw new NumberFormatException("Negative values");
            }

            // Calculate tip amount
            double tipAmount = billAmount * (tipPercentage / 100.0);
            
            // Display the result
            this.tipAmountLabelText = String.format("Tip Amount: $%.2f", tipAmount);
            this.errorMessageLabelText = ""; // Clear errors
            
            System.out.println(this.tipAmountLabelText);

        } catch (NumberFormatException e) {
            // Catch NumberFormatException and display error message
            this.tipAmountLabelText = "Tip Amount: $0.00";
            this.errorMessageLabelText = "Error: Invalid input. Please enter numbers.";
            System.out.println(this.errorMessageLabelText);
        }
    }

    // Step-2: Implement reset() method
    public void reset() {
        this.billAmountText = "";
        this.tipPercentageText = "";
        this.tipAmountLabelText = "Tip Amount: $0.00";
        this.errorMessageLabelText = "";
        System.out.println("Application Reset: All fields cleared.");
    }
}

