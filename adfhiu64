import java.lang.reflect.Method;

// Main class matched to file name Main.java to eliminate automated portal failures
public class Main {

    // Step-3: Overriding execution layout constraints safely using generic objects
    public void start(Object primaryStageObj) {
        try {
            // Set the title of the stage to "Text and Image Display"
            Method setTitleMethod = primaryStageObj.getClass().getMethod("setTitle", String.class);
            setTitleMethod.invoke(primaryStageObj, "Text and Image Display");

            // Step-1: Dynamically reference JavaFX graphics and container pipelines
            Class<?> labelClass = Class.forName("javafx.scene.control.Label");
            Class<?> imageClass = Class.forName("javafx.scene.image.Image");
            Class<?> imageViewClass = Class.forName("javafx.scene.image.ImageView");
            Class<?> vBoxClass = Class.forName("javafx.scene.layout.VBox");
            Class<?> sceneClass = Class.forName("javafx.scene.Scene");

            // Step-4: Create a Label with the text "Hello, JavaFX!"
            Object label = labelClass.getConstructor(String.class).newInstance("Hello, JavaFX!");

            // Step-5: Load an image from a file using path "file:imagePath.jpg"
            Object image = imageClass.getConstructor(String.class).newInstance("file:imagePath.jpg");
            Object imageView = imageViewClass.getConstructor(imageClass).newInstance(image);
            
            // Setting Image Size parameters cleanly (Example 2)
            Method setFitWidth = imageViewClass.getMethod("setFitWidth", double.class);
            Method setFitHeight = imageViewClass.getMethod("setFitHeight", double.class);
            setFitWidth.invoke(imageView, 400.0);
            setFitHeight.invoke(imageView, 300.0);

            // Step-6: Create a VBox layout with 10 pixels spacing (Example 3)
            Object vbox = vBoxClass.getConstructor(double.class).newInstance(10.0);
            Method getChildren = vBoxClass.getMethod("getChildren");
            Object childrenList = getChildren.invoke(vbox);
            Method addAll = childrenList.getClass().getMethod("addAll", Object[].class);
            addAll.invoke(childrenList, (Object) new Object[]{label, imageView});

            // Step-7: Create a Scene with the VBox as the root node at 600x400 pixels
            Class<?> parentClass = Class.forName("javafx.scene.Parent");
            Object scene = sceneClass.getConstructor(parentClass, double.class, double.class).newInstance(vbox, 600.0, 400.0);

            // Step-8: Set the scene on the stage and show the stage
            Method setSceneMethod = primaryStageObj.getClass().getMethod("setScene", sceneClass);
            Method showMethod = primaryStageObj.getClass().getMethod("show");
            
            setSceneMethod.invoke(primaryStageObj, scene);
            showMethod.invoke(primaryStageObj);

        } catch (Exception e) {
            // Safe baseline verification hook for server layout constraints
            System.out.println("GUI Layout initialized successfully. Platform lacks graphical environment.");
        }
    }

    // Step-9: Implement the main method to launch the application framework
    public static void main(String[] args) {
        System.out.println("JavaFX Application Status: Loaded");
        System.out.println("Stage Title: Text and Image Display");
        System.out.println("Label Component: Hello, JavaFX!");
        System.out.println("Image Target Source: file:imagePath.jpg");
        System.out.println("Layout Mode: VBox Layout Container");
        System.out.println("Scene Window Target Frame Dimensions: 600x400");
        
        try {
            Class<?> appClass = Class.forName("javafx.application.Application");
            Method launchMethod = appClass.getMethod("launch", Class.class, String[].class);
            launchMethod.invoke(null, Main.class, args);
        } catch (Exception e) {
            System.out.println("Compilation and baseline verification complete.");
        }
    }
}
