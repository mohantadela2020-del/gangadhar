// =========================================================================
// METHOD 1: EXTENDING THE THREAD CLASS
// =========================================================================
class GoodMorningThread extends Thread {
    @Override
    public void run() {
        try {
            while (!Thread.currentThread().isInterrupted()) {
                System.out.println("Good Morning");
                Thread.sleep(1000);
            }
        } catch (InterruptedException e) {
            // Graceful exit when changing test methods
        }
    }
}

class HelloThread extends Thread {
    @Override
    public void run() {
        try {
            while (!Thread.currentThread().isInterrupted()) {
                System.out.println("Hello");
                Thread.sleep(2000);
            }
        } catch (InterruptedException e) {
            // Graceful exit
        }
    }
}

class WelcomeThread extends Thread {
    @Override
    public void run() {
        try {
            while (!Thread.currentThread().isInterrupted()) {
                System.out.println("Welcome");
                Thread.sleep(3000);
            }
        } catch (InterruptedException e) {
            // Graceful exit
        }
    }
}

// =========================================================================
// METHOD 2: IMPLEMENTING THE RUNNABLE INTERFACE
// =========================================================================
class GoodMorningRunnable implements Runnable {
    @Override
    public void run() {
        try {
            while (true) {
                System.out.println("Good Morning (Runnable)");
                Thread.sleep(1000);
            }
        } catch (InterruptedException e) {
            System.out.println("Good Morning Runnable Interrupted.");
        }
    }
}

class HelloRunnable implements Runnable {
    @Override
    public void run() {
        try {
            while (true) {
                System.out.println("Hello (Runnable)");
                Thread.sleep(2000);
            }
        } catch (InterruptedException e) {
            System.out.println("Hello Runnable Interrupted.");
        }
    }
}

class WelcomeRunnable implements Runnable {
    @Override
    public void run() {
        try {
            while (true) {
                System.out.println("Welcome (Runnable)");
                Thread.sleep(3000);
            }
        } catch (InterruptedException e) {
            System.out.println("Welcome Runnable Interrupted.");
        }
    }
}

// =========================================================================
// MAIN ENTRY POINT FOR PORTAL EXECUTION
// =========================================================================
public class Main {
    public static void main(String[] args) {
        System.out.println("--- STARTING METHOD 1: EXTENDING THREAD CLASS ---");
        
        GoodMorningThread t1 = new GoodMorningThread();
        HelloThread t2 = new HelloThread();
        WelcomeThread t3 = new WelcomeThread();
        
        t1.start();
        t2.start();
        t3.start();

        // Let Method 1 execute for 4 seconds to populate logs dynamically
        try {
            Thread.sleep(4000);
        } catch (InterruptedException e) {
            e.printStackTrace();
        }

        // Stop Method 1 threads safely to shift execution cleanly
        t1.interrupt();
        t2.interrupt();
        t3.interrupt();

        System.out.println("\n--- STARTING METHOD 2: IMPLEMENTING RUNNABLE INTERFACE ---");
        
        Thread r1 = new Thread(new GoodMorningRunnable());
        Thread r2 = new Thread(new HelloRunnable());
        Thread r3 = new Thread(new WelcomeRunnable());
        
        r1.start();
        r2.start();
        r3.start();
    }
}
