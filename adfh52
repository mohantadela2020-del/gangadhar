import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.PreparedStatement;
import java.sql.SQLException;

public class Main {

    // Step-2: Define constants for JDBC URL, username, and password
    private static final String URL = "jdbc:mysql://localhost:3306/mydatabase";
    private static final String USERNAME = "root";
    private static final String PASSWORD = "password";

    public static void main(String[] args) {
        // Step-4: Define the DELETE query
        String deleteQuery = "DELETE FROM users WHERE id = ?";
        
        // Step-3: Use a try-with-resources block to establish a connection and statement
        try (Connection connection = DriverManager.getConnection(URL, USERNAME, PASSWORD);
             PreparedStatement preparedStatement = connection.prepareStatement(deleteQuery)) {
            
            // Step-5: Set the parameter for the WHERE condition (user ID = 2)
            int userIdToDelete = 2;
            preparedStatement.setInt(1, userIdToDelete);
            
            // Step-6: Execute the DELETE statement and store the number of rows affected
            int rowsAffected = preparedStatement.executeUpdate();
            
            // Step-7: Check if rows were deleted and print the respective confirmation message
            if (rowsAffected > 0) {
                System.out.println("Row deleted successfully.");
            } else {
                System.out.println("No rows were deleted.");
            }
            
        } catch (SQLException e) {
            // Step-8: Handle SQLException in the catch block
            System.err.println("Database error occurred: " + e.getMessage());
            e.printStackTrace();
        }
        // Step-9: Resources are automatically closed by try-with-resources
    }
}
